<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for retrohof.co.uk (SmarterASP.NET / win6046.site4now.net).

  This file is required, not optional: IIS refuses to serve file types it does
  not have a MIME mapping for, and .webmanifest is not mapped by default — the
  site manifest would return 404 without the staticContent block below.

  Source file: tools/build.mjs copies it to the repo root on every build.
  Edit this copy, not the generated one at the root.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- remove first: re-adding an existing mapping is a 500 error on IIS -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <!-- Images and fonts are content-addressed by filename; a year is safe.
           CSS and JS are overridden below with a shorter window. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!--
      ====================================================================
      CANONICAL URL REDIRECTS — commented out deliberately. Read before use.
      ====================================================================
      These force https:// and the apex host, matching the canonical tags the
      pages carry (https://retrohof.co.uk/...) and the existing live site. Without them the site
      answers on four URL variants and search engines see duplicates.

      They need the IIS URL Rewrite module. SmarterASP.NET normally has it,
      but if it is missing, a <rewrite> section makes IIS return HTTP 500 for
      the whole site — so this ships disabled rather than risking that on a
      live domain.

      To enable: delete the two comment markers around the <rewrite> block
      below, upload, and load the site. If you get a 500, put them back and
      the site returns to normal immediately.
    -->
    <!--
    <rewrite>
      <rules>
        <rule name="Redirect to https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://retrohof.co.uk/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Redirect www to apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^retrohof\.co\.uk$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://retrohof.co.uk/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="HSTS" enabled="true">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <conditions><add input="{HTTPS}" pattern="on" /></conditions>
          <action type="Rewrite" value="max-age=31536000" />
        </rule>
      </outboundRules>
    </rewrite>
    -->

  </system.webServer>

  <location path="assets/css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="assets/js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
